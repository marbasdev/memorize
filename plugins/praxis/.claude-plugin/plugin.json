{
  "name": "praxis",
  "version": "1.3.5",
  "description": "Stateful memory and execution harness backed by SQLite with lifecycle delta injection, Git rule sync, hybrid PreToolUse/Stop guardrails, and web console.",
  "license": "MIT",
  "repository": "https://github.com/marbasdev/praxis",
  "mcpServers": {
    "praxis": {
      "command": "/bin/sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-praxis.sh"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-praxis.sh\" -hook claude-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-praxis.sh\" -hook claude-turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|REPL",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-praxis.sh\" -hook claude-pretool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-praxis.sh\" -hook claude-stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-praxis.sh\" -hook claude-end"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-praxis.sh\" -hook claude-compact"
          }
        ]
      }
    ]
  }
}
