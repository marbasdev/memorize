{
  "name": "memorize",
  "version": "1.0.1",
  "description": "State-evaluated MCP memory server backed by SQLite with lifecycle context injection, Git rule sync, PreToolUse guardrails, and web console.",
  "license": "MIT",
  "repository": "https://github.com/marbasdev/memorize",
  "mcpServers": {
    "memorize": {
      "command": "/bin/sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-memorize.sh"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-memorize.sh\" -hook claude-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-memorize.sh\" -hook claude-turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-memorize.sh\" -hook claude-pretool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-memorize.sh\" -hook claude-stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-memorize.sh\" -hook claude-end"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-memorize.sh\" -hook claude-compact"
          }
        ]
      }
    ]
  }
}
